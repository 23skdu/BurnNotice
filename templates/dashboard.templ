package templates

templ Dashboard() {
	@Layout("Dashboard")
	<div class="max-w-7xl mx-auto">
		<h1 class="text-3xl font-bold mb-6">System Overview</h1>

		<div class="grid grid-cols-4 gap-4 mb-8"
		     hx-get="/api/summary"
		     hx-trigger="every 2s"
		     hx-swap="innerHTML">
			<div class="bg-gray-800 rounded-lg p-4">
				<h3 class="text-sm text-gray-400">Active Models</h3>
				<p class="text-2xl font-bold text-green-400" id="active-models">0</p>
			</div>
			<div class="bg-gray-800 rounded-lg p-4">
				<h3 class="text-sm text-gray-400">Total Profiles</h3>
				<p class="text-2xl font-bold text-blue-400" id="total-profiles">0</p>
			</div>
			<div class="bg-gray-800 rounded-lg p-4">
				<h3 class="text-sm text-gray-400">Current Alerts</h3>
				<p class="text-2xl font-bold text-yellow-400" id="current-alerts">0</p>
			</div>
			<div class="bg-gray-800 rounded-lg p-4">
				<h3 class="text-sm text-gray-400">System Status</h3>
				<p class="text-2xl font-bold text-green-400" id="system-status">Online</p>
			</div>
		</div>

		<div class="bg-gray-800 rounded-lg p-6">
			<h2 class="text-xl font-semibold mb-4">Recent Activity</h2>
			<div id="recent-activity" class="space-y-2">
				<p class="text-gray-500">No activity yet.</p>
			</div>
		</div>
	</div>
}
